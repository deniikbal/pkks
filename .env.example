# ============================================================
# Contoh konfigurasi. Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# JANGAN pernah commit file .env yang berisi nilai asli.
# ============================================================

# Koneksi database
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/pkks

# Kunci penandatangan cookie sesi.
# Buat nilai acak baru dengan: openssl rand -base64 48
SESSION_SECRET=

# Google Drive: folder akar yang ditampilkan (tempel ID folder di sini)
PKKS_DRIVE_FOLDER_ID=

# Opsi kredensial Drive. Isi SALAH SATU:
# A) Service account (disarankan): path file JSON service account
PKKS_GOOGLE_SERVICE_ACCOUNT_JSON=
# B) OAuth refresh token
PKKS_GOOGLE_CLIENT_ID=
PKKS_GOOGLE_CLIENT_SECRET=
PKKS_GOOGLE_REFRESH_TOKEN=
